  CX --> OR(["גיא · המתאם<br/>בוחר מומחים ומחבר תשובה"]):::ai
  MEM[("זיכרון שיחה")]:::ai -.-> OR
  OR <-. "שאלה ממוקדת / תשובה" .-> D1["סוכן DevOps ואירוח"]:::agent
  OR <-.-> D2["סוכן AI"]:::agent
  OR <-.-> D3["סוכן נתונים ומחסן"]:::agent
  OR <-.-> D4["סוכן כלים, לוטו ולימוד"]:::agent
  OR <-.-> D5["סוכן אתרים ואפליקציות"]:::agent
  OR <-.-> D6["סוכן ניטור"]:::agent
  OR --> SH["עיצוב התשובה<br/>תשובה · פרויקט · שאלות המשך"]:::n8n --> IF{"מהאתר?"}:::n8n
  IF -- כן --> RS["תשובה לגיא באתר"]:::site
