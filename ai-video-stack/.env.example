# Copy to .env (scripts/setup.sh does this and generates the key for you).

# Secret that n8n sends as the X-API-Key header. Long and random - the gateway is exposed via the tunnel.
GATEWAY_API_KEY=change-me

# Public URL of the gateway (your Cloudflare tunnel hostname). Used to build video download links.
PUBLIC_BASE_URL=

# Cloudflare named tunnel token (Zero Trust -> Networks -> Tunnels -> create -> Docker token).
# Point the tunnel's public hostname at http://gateway:8000
CLOUDFLARE_TUNNEL_TOKEN=

# --- Seedance (ByteDance) - API only, weights are not public ---
# BytePlus ModelArk API key: https://console.byteplus.com/ark
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Seedance 2.5 model id on ModelArk (international). Change if your console shows a newer one.
SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# --- HunyuanVideo (local, via ComfyUI) ---
# bf16 = best quality, needs ~24GB VRAM.  fp8 = for 12-16GB cards (set by download-models.sh --fp8).
HUNYUAN_UNET=hunyuan_video_t2v_720p_bf16.safetensors
HUNYUAN_CLIP_L=clip_l.safetensors
HUNYUAN_LLM=llava_llama3_fp8_scaled.safetensors
HUNYUAN_VAE=hunyuan_video_vae_bf16.safetensors

# Extra ComfyUI flags, e.g. --lowvram for 8-12GB cards
COMFYUI_ARGS=
