{
  "name": "AI Video - HunyuanVideo / Seedance via local gateway",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-video",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ai-video-generate"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "every-day-09:00",
      "name": "Every day 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "id": "manual-run",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "gateway_url",
              "name": "gateway_url",
              "value": "https://video.example.com",
              "type": "string"
            },
            {
              "id": "provider",
              "name": "provider",
              "value": "={{ ($json.body || {}).provider || 'auto' }}",
              "type": "string"
            },
            {
              "id": "prompt",
              "name": "prompt",
              "value": "={{ ($json.body || {}).prompt || 'A drone shot over a Mediterranean beach at sunset, cinematic, 4k' }}",
              "type": "string"
            },
            {
              "id": "image_url",
              "name": "image_url",
              "value": "={{ ($json.body || {}).image_url || '' }}",
              "type": "string"
            },
            {
              "id": "width",
              "name": "width",
              "value": "={{ ($json.body || {}).width || 848 }}",
              "type": "number"
            },
            {
              "id": "height",
              "name": "height",
              "value": "={{ ($json.body || {}).height || 480 }}",
              "type": "number"
            },
            {
              "id": "frames",
              "name": "frames",
              "value": "={{ ($json.body || {}).frames || 73 }}",
              "type": "number"
            },
            {
              "id": "steps",
              "name": "steps",
              "value": "={{ ($json.body || {}).steps || 30 }}",
              "type": "number"
            },
            {
              "id": "duration",
              "name": "duration",
              "value": "={{ ($json.body || {}).duration || 5 }}",
              "type": "number"
            },
            {
              "id": "resolution",
              "name": "resolution",
              "value": "={{ ($json.body || {}).resolution || '720p' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.gateway_url }}/v1/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ provider: $json.provider, prompt: $json.prompt, width: $json.width, height: $json.height, frames: $json.frames, steps: $json.steps, duration: $json.duration, resolution: $json.resolution, image_url: $json.image_url || null }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "submit-job",
      "name": "Submit job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aiVideoGatewayKey",
          "name": "AI Video Gateway"
        }
      }
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "wait-20s",
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        740,
        200
      ],
      "webhookId": "ai-video-wait"
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.gateway_url }}/v1/jobs/{{ $('Submit job').item.json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "get-job",
      "name": "Get job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aiVideoGatewayKey",
          "name": "AI Video Gateway"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "finished",
              "leftValue": "={{ ['succeeded', 'failed'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "finished",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1180,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "succeeded",
      "name": "Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1400,
        100
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.video_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 300000
        }
      },
      "id": "download-video",
      "name": "Download video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aiVideoGatewayKey",
          "name": "AI Video Gateway"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Video job ' + $json.id + ' failed (' + $json.provider + '): ' + $json.error }}"
      },
      "id": "generation-failed",
      "name": "Generation failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1620,
        200
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every day 09:00": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual run": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Submit job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit job": {
      "main": [
        [
          {
            "node": "Wait 20s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 20s": {
      "main": [
        [
          {
            "node": "Get job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get job": {
      "main": [
        [
          {
            "node": "Finished?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished?": {
      "main": [
        [
          {
            "node": "Succeeded?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 20s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Succeeded?": {
      "main": [
        [
          {
            "node": "Download video",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generation failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
