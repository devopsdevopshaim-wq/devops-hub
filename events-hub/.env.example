# העתק לקובץ .env ומלא ערכים
PORT=3000
# כתובת ציבורית של האתר (משמשת ל-QR ולחזרה מדף הסליקה)
PUBLIC_URL=http://localhost:3000
# סיסמת מנהל - חובה לשנות!
ADMIN_PASSWORD=change-me
# מפתח לחתימת עוגיות התחברות - מחרוזת אקראית ארוכה
SESSION_SECRET=replace-with-long-random-string

# ספק סליקה: mock (בדיקות) | tranzila | cardcom | grow | payplus
PAYMENT_PROVIDER=mock
PAYMENT_TERMINAL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# AI (אופציונלי) - הסרת רקע דרך remove.bg
REMOVE_BG_API_KEY=
