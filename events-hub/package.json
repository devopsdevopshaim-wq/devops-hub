{
  "name": "events-hub",
  "version": "2.0.0",
  "description": "פריים אירועים: אפליקציה לאירועים. האתר ב-GitHub Pages, השרת ב-Cloudflare Workers, הכול נפרס מ-GitHub",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "worker:dev": "wrangler dev --local",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  },
